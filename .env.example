# Copia este archivo como `.env` y completa los valores reales.
# Nunca commitees el archivo `.env` con secretos reales (ya está en .gitignore).

# --- Aplicación ---
APP_NAME="Voluntaco API"
APP_VERSION="1.0.0"
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Seguridad ---
# Genera un valor aleatorio y robusto, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY_LOGIN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45

# --- Base de datos (Turso / libsql) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- CORS ---
# Lista separada por comas con los orígenes permitidos del frontend.
# Evita usar "*" en producción, especialmente junto con credenciales.
ALLOWED_ORIGINS=["http://localhost:3000"]
